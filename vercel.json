{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/round.js": { "maxDuration": 45 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ]
}
